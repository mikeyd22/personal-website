{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5501",
        "--directory",
        "public"
      ],
      "port": 5501
    },
    {
      "name": "firebase",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "serve",
        "--only",
        "hosting",
        "--port",
        "5555"
      ],
      "port": 5555
    }
  ]
}